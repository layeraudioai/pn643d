; Nintenstation643D-only affine texture mapping vertex shader.
; Project to clip space, then divide by w at each vertex and emit w=1.
; The rasterizer therefore interpolates texture coordinates linearly in
; screen space instead of perspective-correcting them, reproducing the
; characteristic PS1 affine texture warp. Depth remains z/w.

.fvec projection[4]

.constf myconst(0.0, 1.0, -1.0, 0.00392156862)
.alias  ones myconst.yyyy
.alias  rgba8_to_float myconst.wwww

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1

.alias inpos  v0
.alias inclr  v1
.alias intex  v2
.alias intex2 v3

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones

	; r1 = projection * position (homogeneous clip coordinates).
	dp4 r1.x, projection[0], r0
	dp4 r1.y, projection[1], r0
	dp4 r1.z, projection[2], r0
	dp4 r1.w, projection[3], r0

	; Convert to NDC before rasterization and force w=1. This preserves the
	; projected vertex/depth positions while disabling perspective correction
	; for the texture-coordinate varyings.
	rcp r2.x, r1.w
	mul outpos.xyz, r1, r2.xxxx
	mov outpos.w, ones

	mov outtc0, intex
	mov outtc1, intex2

	cmp inclr.w, gt, gt, r0.w
	ifc cmp.x
		mul outclr, rgba8_to_float, inclr
	.else
		mov outclr, inclr
	.end
	end
.end
