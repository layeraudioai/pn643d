; Nintenstation643D shader with a restrained affine texture effect.
; Keep 15% of projected clip-w variation to soften texture warping while
; preserving the original projected vertex positions and depth.

.fvec projection[4]

.constf myconst(0.0, 1.0, -1.0, 0.00392156862)
.constf affine_strength(0.15, 0.85, 0.0, 0.0)
.alias  ones myconst.yyyy
.alias  rgba8_to_float myconst.wwww
.alias  affine_mul affine_strength.xxxx
.alias  affine_bias affine_strength.yyyy

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1

.alias inpos  v0
.alias inclr  v1
.alias intex  v2
.alias intex2 v3

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones

	; r1 = projection * position (homogeneous clip coordinates).
	dp4 r1.x, projection[0], r0
	dp4 r1.y, projection[1], r0
	dp4 r1.z, projection[2], r0
	dp4 r1.w, projection[3], r0

	; Reduce perspective correction by blending clipW with signed sqrt(abs(clipW)).
	; Keeping the same sign and zero crossing avoids turning behind-camera vertices
	; into visible ones during camera rotation (the old additive bias did that).
	; The 15% blend is intentionally subtle; clip-space positions stay equivalent.
	max r2.x, r1.w, -r1.w
	rsq r2.y, r2.x
	rcp r2.y, r2.y
	rcp r2.z, r2.x
	mul r2.z, r1.w, r2.z
	mul r2.y, r2.y, r2.z
	mul r2.z, affine_mul, r2.y
	mul r2.y, affine_bias, r1.w
	add r2.x, r2.z, r2.y
	rcp r2.y, r1.w
	mul r1.xyz, r1, r2.yyyy
	mul outpos.xyz, r1, r2.xxxx
	mov outpos.w, r2.x

	mov outtc0, intex
	mov outtc1, intex2

	cmp inclr.w, gt, gt, r0.w
	ifc cmp.x
		mul outclr, rgba8_to_float, inclr
	.else
		mov outclr, inclr
	.end
	end
.end
