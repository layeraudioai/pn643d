; Nintenstation643D shader with a restrained affine texture effect.
; Keep 35% of projected clip-w variation to soften texture warping while
; preserving the original projected vertex positions and depth.

.fvec projection[4]

.constf myconst(0.0, 1.0, -1.0, 0.00392156862)
.constf affine_strength(0.35, 0.65, 0.0, 0.0)
.alias  ones myconst.yyyy
.alias  rgba8_to_float myconst.wwww
.alias  affine_mul affine_strength.xxxx
.alias  affine_bias affine_strength.yyyy

.out outpos position
.out outclr color
.out outtc0 texcoord0
.out outtc1 texcoord1

.alias inpos  v0
.alias inclr  v1
.alias intex  v2
.alias intex2 v3

.proc main
	mov r0.xyz, inpos
	mov r0.w, ones

	; r1 = projection * position (homogeneous clip coordinates).
	dp4 r1.x, projection[0], r0
	dp4 r1.y, projection[1], r0
	dp4 r1.z, projection[2], r0
	dp4 r1.w, projection[3], r0

	; Soften the perspective denominator instead of forcing it to 1.0.
	; outW = 0.35 * clipW + 0.65 blends affine and perspective-correct mapping.
	; Normalize by original clipW, then restore softened W so screen position
	; and depth remain unchanged while texture interpolation warps less.
	rcp r2.y, r1.w
	mul r2.x, affine_mul, r1.w
	add r2.x, affine_bias, r2.x
	mul r1.xyz, r1, r2.yyyy
	mul outpos.xyz, r1, r2.xxxx
	mov outpos.w, r2.x

	mov outtc0, intex
	mov outtc1, intex2

	cmp inclr.w, gt, gt, r0.w
	ifc cmp.x
		mul outclr, rgba8_to_float, inclr
	.else
		mov outclr, inclr
	.end
	end
.end
